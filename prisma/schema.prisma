// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// User Management
enum UserRole {
  USER
  TEAM_CAPTAIN
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  discordId     String?   @unique
  discordTag    String?
  minecraftUsername String? @unique
  role          UserRole  @default(USER)
  status        UserStatus @default(ACTIVE)
  bio           String?   @db.Text
  elo           Int       @default(1000)
  wins          Int       @default(0)
  losses        Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  teamMembers   TeamMember[]
  tournamentTeamPlayers TournamentTeamPlayer[]
  createdTeams  Team[]       @relation("TeamCreator")
  createdTournaments Tournament[] @relation("TournamentCreator")
  matchReports  MatchReport[]
  notifications Notification[]
  auditLogs     AuditLog[]
  bans          Ban[]        @relation("BannedUser")
  bansByModerator Ban[]      @relation("BanModerator")
  shopOrders    ShopOrder[]
  tournamentInvitesSent TournamentTeamInvite[] @relation("TournamentInviteSender")
  tournamentInvitesReceived TournamentTeamInvite[] @relation("TournamentInviteRecipient")

  @@index([discordId])
  @@index([role])
  @@index([status])
}

// Team System
enum TeamVisibility {
  PUBLIC
  PRIVATE
}

model Team {
  id          String         @id @default(cuid())
  name        String         @unique
  tag         String         @unique
  logo        String?
  description String?        @db.Text
  visibility  TeamVisibility @default(PUBLIC)
  wins        Int            @default(0)
  losses      Int            @default(0)
  elo         Int            @default(1000)
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  createdBy       User               @relation("TeamCreator", fields: [createdById], references: [id])
  members         TeamMember[]
  invitations     TeamInvitation[]
  tournamentTeams TournamentTeam[]
  matches         Match[]            @relation("TeamMatches")

  @@index([createdById])
  @@index([visibility])
}

enum TeamMemberRole {
  CAPTAIN
  CO_CAPTAIN
  MEMBER
}

model TeamMember {
  id        String         @id @default(cuid())
  teamId    String
  userId    String
  role      TeamMemberRole @default(MEMBER)
  joinedAt  DateTime       @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

// Invitation System
enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model TeamInvitation {
  id        String           @id @default(cuid())
  teamId    String
  token     String           @unique @default(cuid())
  email     String?
  discordId String?
  status    InvitationStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime         @default(now())
  usedAt    DateTime?

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([token])
  @@index([status])
}

// Tournament System
enum TournamentStatus {
  DRAFT
  UPCOMING
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  LIVE
  FINISHED
  CANCELLED
}

enum TournamentFormat {
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
  ROUND_ROBIN
  SWISS
}

enum TournamentTeamMode {
  SOLO
  DUO
  TRIO
}

model Tournament {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  description     String?          @db.Text
  rules           String?          @db.Text
  banner          String?
  format          TournamentFormat
  teamMode        TournamentTeamMode @default(SOLO)
  playersPerTeam  Int              @default(5)
  status          TournamentStatus @default(DRAFT)
  maxTeams        Int
  minTeams        Int              @default(2)
  prizePool       String?
  registrationStart DateTime?
  registrationEnd   DateTime?
  startDate       DateTime
  endDate         DateTime?
  checkInStart    DateTime?
  checkInEnd      DateTime?
  createdById     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  createdBy User             @relation("TournamentCreator", fields: [createdById], references: [id])
  teams     TournamentTeam[]
  invites   TournamentTeamInvite[]
  matches   Match[]
  rounds    Round[]

  @@index([slug])
  @@index([status])
  @@index([createdById])
  @@index([startDate])
}

enum TournamentTeamStatus {
  PENDING
  REGISTERED
  CHECKED_IN
  DISQUALIFIED
  WITHDRAWN
}

model TournamentTeam {
  id           String               @id @default(cuid())
  tournamentId String
  teamId       String
  status       TournamentTeamStatus @default(REGISTERED)
  seed         Int?
  checkedInAt  DateTime?
  registeredAt DateTime             @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  players    TournamentTeamPlayer[]
  invites    TournamentTeamInvite[]

  @@unique([tournamentId, teamId])
  @@index([tournamentId])
  @@index([teamId])
  @@index([status])
}

model TournamentTeamPlayer {
  id               String   @id @default(cuid())
  tournamentTeamId String
  userId           String
  createdAt        DateTime @default(now())

  tournamentTeam TournamentTeam @relation(fields: [tournamentTeamId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentTeamId, userId])
  @@index([tournamentTeamId])
  @@index([userId])
}

model TournamentTeamInvite {
  id               String           @id @default(cuid())
  tournamentTeamId String
  tournamentId     String
  invitedById      String
  invitedUserId    String
  token            String           @unique @default(cuid())
  status           InvitationStatus @default(PENDING)
  expiresAt        DateTime
  createdAt        DateTime         @default(now())
  respondedAt      DateTime?

  tournamentTeam TournamentTeam @relation(fields: [tournamentTeamId], references: [id], onDelete: Cascade)
  tournament     Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  invitedBy      User           @relation("TournamentInviteSender", fields: [invitedById], references: [id], onDelete: Cascade)
  invitedUser    User           @relation("TournamentInviteRecipient", fields: [invitedUserId], references: [id], onDelete: Cascade)

  @@index([tournamentTeamId])
  @@index([tournamentId])
  @@index([invitedById])
  @@index([invitedUserId])
  @@index([status])
  @@index([token])
}

// Match System
model Round {
  id           String   @id @default(cuid())
  tournamentId String
  roundNumber  Int
  name         String
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matches    Match[]

  @@unique([tournamentId, roundNumber])
  @@index([tournamentId])
}

enum MatchStatus {
  SCHEDULED
  LIVE
  COMPLETED
  DISPUTED
  CANCELLED
}

model Match {
  id           String      @id @default(cuid())
  tournamentId String
  roundId      String?
  team1Id      String
  team2Id      String?
  team1Score   Int         @default(0)
  team2Score   Int         @default(0)
  winnerId     String?
  status       MatchStatus @default(SCHEDULED)
  scheduledAt  DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  bracketPosition Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  tournament Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  round      Round?        @relation(fields: [roundId], references: [id])
  team1      Team          @relation("TeamMatches", fields: [team1Id], references: [id])
  reports    MatchReport[]

  @@index([tournamentId])
  @@index([roundId])
  @@index([team1Id])
  @@index([status])
}

model MatchReport {
  id          String   @id @default(cuid())
  matchId     String
  reportedById String
  team1Score  Int
  team2Score  Int
  evidence    String?  @db.Text
  notes       String?  @db.Text
  createdAt   DateTime @default(now())

  match       Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  reportedBy  User  @relation(fields: [reportedById], references: [id])

  @@index([matchId])
  @@index([reportedById])
}

// Notification System
enum NotificationType {
  TEAM_INVITATION
  TOURNAMENT_INVITATION
  MATCH_SCHEDULED
  MATCH_RESULT
  TOURNAMENT_UPDATE
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

// Ban System
model Ban {
  id          String    @id @default(cuid())
  userId      String
  moderatorId String
  reason      String    @db.Text
  expiresAt   DateTime?
  permanent   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)
  moderator User @relation("BanModerator", fields: [moderatorId], references: [id])

  @@index([userId])
  @@index([moderatorId])
  @@index([expiresAt])
}

// Audit Log System
enum AuditAction {
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  USER_BANNED
  USER_UNBANNED
  TEAM_CREATED
  TEAM_UPDATED
  TEAM_DELETED
  TOURNAMENT_CREATED
  TOURNAMENT_UPDATED
  TOURNAMENT_DELETED
  MATCH_CREATED
  MATCH_UPDATED
  MATCH_DELETED
  PERMISSION_CHANGED
}

model AuditLog {
  id          String      @id @default(cuid())
  userId      String
  action      AuditAction
  entityType  String
  entityId    String
  changes     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

// Platform Settings System
model PlatformSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  category  String
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@index([category])
  @@index([key])
}

// Shop System
enum ShopOrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

model ShopCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?  @db.Text
  imageUrl    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products ShopProduct[]

  @@index([isActive])
  @@index([sortOrder])
}

model ShopProduct {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  shortDescription String? @db.Text
  description     String?  @db.Text
  imageUrl        String?
  galleryUrls     Json?
  priceCents      Int
  currency        String   @default("EUR")
  isActive        Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  stock           Int?     // null = unlimited (virtual items)
  deliveryHint    String?  @db.Text // e.g. "Delivered in-game within minutes"
  deliveryCommand String?  @db.Text // optional server-side command template
  metadata        Json?
  categoryId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category ShopCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems ShopOrderItem[]

  @@index([isActive])
  @@index([isFeatured])
  @@index([categoryId])
  @@index([priceCents])
}

model ShopOrder {
  id         String          @id @default(cuid())
  userId     String?
  status     ShopOrderStatus @default(PENDING)
  currency   String          @default("EUR")
  totalCents Int
  notes      String?         @db.Text
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  user  User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  items ShopOrderItem[]

  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

model ShopOrderItem {
  id             String   @id @default(cuid())
  orderId        String
  productId      String
  quantity       Int      @default(1)
  unitPriceCents Int
  createdAt      DateTime @default(now())

  order   ShopOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product ShopProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}
